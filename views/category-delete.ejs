<%- include('partials/header') %>

    <div class="heading-and-link-wrapper">
        <h1>Delete "<%= category.name %>"?</h1>
    </div>

    <% if (products.length> 0) { %>
        <div class="card notice notice-warning">
            <p>
                This category still has <%= products.length %> product(s) in it.
                    You must delete or reassign these products before deleting the category.
            </p>
            <ul class="blocked-list">
                <% products.forEach(product=> { %>
                    <li>
                        <%= product.name %>
                    </li>
                    <% }) %>
            </ul>
            <div class="form-actions">
                <a href="/categories/<%= category.category_id %>" class="btn btn-secondary">Back to category</a>
            </div>
        </div>
        <% } else { %>
            <div class="card notice notice-danger">
                <p>Are you sure you want to delete this category? This cannot be undone.</p>
                <div class="form-actions">
                    <form action="/categories/<%= category.category_id %>/delete" method="POST">
                        <button type="submit" class="btn btn-danger">Yes, delete it</button>
                    </form>
                    <a href="/categories/<%= category.category_id %>" class="btn btn-secondary">Cancel</a>
                </div>
            </div>
            <% } %>

                <%- include('partials/footer') %>