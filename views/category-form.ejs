<%- include('partials/header') %>

    <div class="heading-and-link-wrapper">
        <h1>
            <%= category ? 'Edit Category' : 'Add New Category' %>
        </h1>
    </div>

    <%- include('partials/validation-errors') %>

        <form class="card form-card"
            action="<%= category && category.category_id ? `/categories/${category.category_id}/update` : '/categories/create' %>"
            method="POST">
            <div class="form-field">
                <label for="name">Category Name *</label>
                <input type="text" id="name" name="name" value="<%= category ? category.name : '' %>" required>
            </div>

            <div class="form-field">
                <label for="description">Description</label>
                <textarea id="description" name="description"
                    rows="4"><%= category ? category.description : '' %></textarea>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    <%= category ? 'Update Category' : 'Create Category' %>
                </button>
                <a href="/categories" class="btn btn-secondary">Cancel</a>
            </div>
        </form>

        <%- include('partials/footer') %>