<%- include('partials/header') %>

    <div class="heading-and-link-wrapper">
        <h1>
            <%= category.name %>
        </h1>
        <div class="action-group">
            <a href="/categories/<%= category.category_id %>/update" class="btn btn-secondary"><%-
                    include('partials/icons/pen') %>Edit Category</a>
            <a href="/categories/<%= category.category_id %>/delete" class="btn btn-danger"><%-
                    include('partials/icons/trash') %>Delete Category</a>
        </div>
    </div>

    <% if (category.description) { %>
        <p class="page-intro">
            <%= category.description %>
        </p>
        <% } %>

            <h2 class="section-heading">Products</h2>

            <% if (products.length===0) { %>
                <div class="empty-state">
                    <p>No products in this category yet.</p>
                </div>
                <% } else { %>
                    <ul class="item-list">
                        <% products.forEach(product=> { %>
                            <li class="item-row">
                                <div class="item-main">
                                    <a href="/products/<%= product.product_id %>" class="item-link">
                                        <%= product.name %>
                                    </a>
                                </div>
                                <p class="item-meta">$<%= product.price %> &verbar; Qty: <%= product.quantity %>
                                </p>
                            </li>
                            <% }) %>
                    </ul>
                    <% } %>

                        <a href="/categories" class="back-link">&larr; Back to Categories</a>

                        <%- include('partials/footer') %>