<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>
        <%= category.name %>
    </title>
</head>

<body>
    <h1>
        <%= category.name %>
    </h1>
    <p>
        <%= category.description %>
    </p>

    <a href="/categories/<%= category.category_id %>/update">Edit Category</a>
    <a href="/categories/<%= category.category_id %>/delete">Delete Category</a>
    <a href="/categories">Back to Categories</a>

    <h2>Products</h2>

    <% if (products.length===0) { %>
        <p>No products in this category yet.</p>
        <% } else { %>
            <ul>
                <% products.forEach(product=> { %>
                    <li>
                        <%= product.name %> — $<%= product.price %> — Qty: <%= product.quantity %>
                    </li>
                    <% }) %>
            </ul>
            <% } %>
</body>

</html>