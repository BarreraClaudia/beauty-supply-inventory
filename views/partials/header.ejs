<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Croissant+One&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
    rel="stylesheet">

  <title>Beauty Supply Inventory</title>
  <link rel="stylesheet" href="/styles.css">

  <script src="/nav-toggle.js" defer></script>
</head>

<body>
  <header class="site-header">

    <div class="logo-brand-wrapper">
      <img src="/images/angel-icon.png" alt="logo" width="50">
      <a class="brand" href="/">Angel Beauty</a>
    </div>

    <!-- hamburger for smaller screens -->
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav"
      aria-label="Toggle navigation">
      <%- include('icons/menu') %>
        <%- include('icons/x') %>
    </button>


    <nav id="site-nav" class="site-nav">
      <a href="/products" class="nav-link <%= currentPath.startsWith('/products') ? 'active' : '' %>"><%-
          include('icons/box') %>Products</a>

      <a href="/categories" class="nav-link <%= currentPath.startsWith('/categories') ? 'active' : '' %>"><%-
          include('icons/folder') %>Categories</a>

      <a href="/suppliers" class="nav-link <%= currentPath.startsWith('/suppliers') ? 'active' : '' %>"><%-
          include('icons/truck') %>Suppliers</a>
    </nav>
  </header>

  <main>