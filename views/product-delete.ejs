<%- include('partials/header') %>

    <div class="heading-and-link-wrapper">
        <h1>Delete &ldquo;<%= product.name %>&rdquo;?</h1>
    </div>

    <div class="card notice notice-danger">
        <p>This cannot be undone.</p>

        <dl class="detail-grid">
            <dt>SKU</dt>
            <dd>
                <%= product.sku %>
            </dd>
            <dt>Quantity in stock</dt>
            <dd>
                <%= product.quantity %>
            </dd>
        </dl>

        <div class="form-actions">
            <form action="/products/<%= product.product_id %>/delete" method="POST">
                <button type="submit" class="btn btn-danger">Yes, delete it</button>
            </form>
            <a href="/products/<%= product.product_id %>" class="btn btn-secondary">Cancel</a>
        </div>
    </div>

    <%- include('partials/footer') %>