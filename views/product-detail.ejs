<%- include('partials/header') %>

    <h1>
        <%= product.name %>
    </h1>

    <% if (product.description) { %>
        <p>
            <%= product.description %>
        </p>
        <% } %>

            <ul>
                <li>SKU: <%= product.sku %>
                </li>
                <li>Price: $<%= product.price %>
                </li>
                <li>Quantity: <%= product.quantity %>
                </li>
                <li>Reorder Level: <%= product.reorder_level %>
                </li>
            </ul>

            <a href="/products/<%= product.product_id %>/update">Edit</a>
            <a href="/products/<%= product.product_id %>/delete">Delete</a>
            <a href="/products">Back to Products</a>

            <%- include('partials/footer') %>