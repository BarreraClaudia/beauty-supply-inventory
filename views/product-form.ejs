<h1>
    <%= product ? 'Edit Product' : 'Add New Product' %>
</h1>

<%- include('partials/validation-errors') %>

    <form action="<%= product && product.product_id ? `/products/${product.product_id}/update` : '/products/create' %>"
        method="POST">
        <div>
            <label for="sku">SKU</label>
            <input type="text" id="sku" name="sku" value="<%= product ? product.sku : '' %>" required>
        </div>

        <div>
            <label for="name">Product Name</label>
            <input type="text" id="name" name="name" value="<%= product ? product.name : '' %>" required>
        </div>

        <div>
            <label for="description">Description</label>
            <textarea id="description" name="description"
                rows="4"><%= product ? (product.description || '') : '' %></textarea>
        </div>

        <div>
            <label for="category_id">Category</label>
            <select id="category_id" name="category_id" required>
                <option value="">Select a category</option>
                <% categories.forEach(category=> { %>
                    <option value="<%= category.category_id %>" <%=product && product.category_id==category.category_id
                        ? 'selected' : '' %>
                        >
                        <%= category.name %>
                    </option>
                    <% }) %>
            </select>
        </div>

        <div>
            <label for="supplier_id">Supplier</label>
            <select id="supplier_id" name="supplier_id" required>
                <option value="">Select a supplier</option>
                <% suppliers.forEach(supplier=> { %>
                    <option value="<%= supplier.supplier_id %>" <%=product && product.supplier_id==supplier.supplier_id
                        ? 'selected' : '' %>
                        >
                        <%= supplier.name %>
                    </option>
                    <% }) %>
            </select>
        </div>

        <div>
            <label for="price">Price</label>
            <input type="number" id="price" name="price" step="0.01" min="0" value="<%= product ? product.price : '' %>"
                required>
        </div>

        <div>
            <label for="quantity">Quantity</label>
            <input type="number" id="quantity" name="quantity" min="0" value="<%= product ? product.quantity : 0 %>"
                required>
        </div>

        <div>
            <label for="reorder_level">Reorder Level</label>
            <input type="number" id="reorder_level" name="reorder_level" min="0"
                value="<%= product ? product.reorder_level : 5 %>" required>
        </div>

        <button type="submit">
            <%= product ? 'Update Product' : 'Create Product' %>
        </button>
    </form>