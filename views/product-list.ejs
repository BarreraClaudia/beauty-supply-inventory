<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Products</title>
</head>

<body>
    <h1>Products</h1>

    <a href="/products/create">Add New Product</a>

    <form action="/products" method="GET" class="search-form">
        <input type="text" name="q" placeholder="Search by name or SKU" value="<%= query %>">
        <button type="submit">Search</button>
        <% if (query) { %>
            <a href="/products">Clear</a>
            <% } %>
    </form>

    <% if (products.length===0) { %>
        <div class="empty-state">
            <p>
                <%= query ? `No products match "${query}" ` : 'No products yet. Add the first one to get started.' %>
            </p>
        </div>
        <% } else { %>
            <ul>
                <% products.forEach(product=> { %>
                    <li>
                        <a href="/products/<%= product.product_id %>">
                            <%= product.name %>
                        </a>
                        — $<%= product.price %> — Qty: <%= product.quantity %>
                                <a href="/products/<%= product.product_id %>/update">Edit</a>
                                <a href="/products/<%= product.product_id %>/delete">Delete</a>
                    </li>
                    <% }) %>
            </ul>
            <% } %>
</body>

</html>