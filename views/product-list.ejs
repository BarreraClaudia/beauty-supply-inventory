<%- include('partials/header') %>

    <div class="heading-and-link-wrapper">
        <h1>Products</h1>
        <a href="/products/create" class="form-link"><%- include('partials/icons/plus') %>Add Product</a>
    </div>

    <form action="/products" method="GET" class="product-search-form">
        <input type="text" name="q" placeholder="Search by name or SKU" value="<%= query %>"
            class="product-search-input">
        <button type="submit" class="product-search-btn">Search</button>
        <% if (query) { %>
            <a href="/products" class="clear-link">Clear</a>
            <% } %>
    </form>

    <% if (products.length===0) { %>
        <div class="empty-state">
            <p>
                <%= query ? `No products match "${query}" ` : 'No products yet. Add the first one to get started.' %>
            </p>
        </div>
        <% } else { %>
            <ul class="product-list">
                <li class="product-item product-list-titles">
                    <span>SKU</span>
                    <span>Product</span>
                    <span>Price</span>
                    <span>Qty</span>
                    <span>Status</span>
                    <!-- empty spans to align columns -->
                    <span></span>
                    <span></span>
                </li>
                <% products.forEach(product=> { %>
                    <li class="product-item">
                        <span>
                            <%=product.sku%>
                        </span>
                        <a href="/products/<%= product.product_id %>" class="product-name">
                            <%=product.name%>
                        </a>
                        <span>
                            $<%=product.price%>
                        </span>
                        <span>
                            <%=product.quantity%>
                        </span>

                        <%- include('partials/stock-badge', { product }) %>

                            <a href="/products/<%= product.product_id %>/update"><%- include('partials/icons/pen')
                                    %></a>
                            <a href="/products/<%= product.product_id %>/delete"><%- include('partials/icons/trash')
                                    %></a>
                    </li>
                    <% }) %>
            </ul>
            <% } %>

                <%- include('partials/footer') %>