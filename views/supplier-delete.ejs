<%- include('partials/header') %>

    <div class="heading-and-link-wrapper">
        <h1>Delete &ldquo;<%= supplier.name %>&rdquo;?</h1>
    </div>

    <% if (products.length> 0) { %>
        <div class="card notice notice-warning">
            <p>
                This supplier still provides <%= products.length %> product<%= products.length===1 ? '' : 's' %>.
                        Remove or reassign them before deleting the supplier.
            </p>
            <ul class="blocked-list">
                <% products.forEach(product=> { %>
                    <li>
                        <%= product.name %>
                    </li>
                    <% }) %>
            </ul>
            <div class="form-actions">
                <a href="/suppliers/<%= supplier.supplier_id %>" class="btn btn-secondary">Back to Supplier</a>
            </div>
        </div>
        <% } else { %>
            <div class="card notice notice-danger">
                <p>This cannot be undone.</p>
                <div class="form-actions">
                    <form action="/suppliers/<%= supplier.supplier_id %>/delete" method="POST">
                        <button type="submit" class="btn btn-danger">Yes, delete it</button>
                    </form>
                    <a href="/suppliers/<%= supplier.supplier_id %>" class="btn btn-secondary">Cancel</a>
                </div>
            </div>
            <% } %>

                <%- include('partials/footer') %>