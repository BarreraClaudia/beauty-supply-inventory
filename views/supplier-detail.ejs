<%- include('partials/header') %>

    <div class="heading-and-link-wrapper">
        <h1>
            <%= supplier.name %>
        </h1>
        <div class="action-group">
            <a href="/suppliers/<%= supplier.supplier_id %>/update" class="btn btn-secondary"><%-
                    include('partials/icons/pen') %>Edit</a>
            <a href="/suppliers/<%= supplier.supplier_id %>/delete" class="btn btn-danger"><%-
                    include('partials/icons/trash') %>Delete</a>
        </div>
    </div>

    <div class="card detail-card">
        <dl class="detail-grid">
            <dt>Email</dt>
            <dd>
                <%= supplier.email %>
            </dd>
            <% if (supplier.phone) { %>
                <dt>Phone</dt>
                <dd>
                    <%= supplier.phone %>
                </dd>
                <% } %>
                    <% if (supplier.address) { %>
                        <dt>Address</dt>
                        <dd>
                            <%= supplier.address %>
                        </dd>
                        <% } %>
                            <dt>Delivery Time</dt>
                            <dd>
                                <%= supplier.delivery_time_days %> days
                            </dd>
        </dl>
    </div>

    <h2 class="section-heading">Products Supplied</h2>

    <% if (products.length===0) { %>
        <div class="empty-state">
            <p>No products from this supplier yet.</p>
        </div>
        <% } else { %>
            <ul class="item-list">
                <% products.forEach(product=> { %>
                    <li class="item-row">
                        <div class="item-main">
                            <a href="/products/<%= product.product_id %>" class="item-link">
                                <%= product.name %>
                            </a>
                        </div>
                        <p class="item-meta">$<%= product.price %> &verbar; Qty: <%= product.quantity %>
                        </p>
                    </li>
                    <% }) %>
            </ul>
            <% } %>

                <a href="/suppliers" class="back-link">&larr; Back to Suppliers</a>

                <%- include('partials/footer') %>