<h1>
    <%= supplier ? 'Edit Supplier' : 'Add New Supplier' %>
</h1>

<%- include('partials/validation-errors') %>

    <form
        action="<%= supplier && supplier.supplier_id ? `/suppliers/${supplier.supplier_id}/update` : '/suppliers/create' %>"
        method="POST">
        <div>
            <label for="name">Supplier Name</label>
            <input type="text" id="name" name="name" value="<%= supplier ? supplier.name : '' %>" required>
        </div>

        <div>
            <label for="email">Email</label>
            <input type="email" id="email" name="email" value="<%= supplier ? supplier.email : '' %>">
        </div>

        <div>
            <label for="phone">Phone</label>
            <input type="text" id="phone" name="phone" value="<%= supplier ? (supplier.phone || '') : '' %>">
        </div>

        <div>
            <label for="address">Address</label>
            <input type="text" id="address" name="address" value="<%= supplier ? (supplier.address || '') : '' %>">
        </div>

        <div>
            <label for="delivery_time_days">Delivery Time (days)</label>
            <input type="number" id="delivery_time_days" name="delivery_time_days" min="0"
                value="<%= supplier ? supplier.delivery_time_days : '' %>">
        </div>

        <button type="submit">
            <%= supplier ? 'Update Supplier' : 'Create Supplier' %>
        </button>
    </form>