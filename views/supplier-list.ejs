<%- include('partials/header') %>

    <div class="heading-and-link-wrapper">
        <h1>Suppliers</h1>
        <a href="/suppliers/create" class="form-link"><%- include('partials/icons/plus') %>Add Supplier</a>
    </div>

    <% if (suppliers.length===0) { %>
        <div class="empty-state">
            <p>No suppliers yet.</p>
        </div>
        <% } else { %>
            <ul class="item-list">
                <% suppliers.forEach(supplier=> { %>
                    <li class="item-row">
                        <div class="item-main">
                            <a href="/suppliers/<%= supplier.supplier_id %>" class="item-link">
                                <%= supplier.name %>
                            </a>
                            <p class="item-meta">
                                <%= supplier.email %>
                            </p>
                        </div>
                        <div class="item-actions">
                            <a href="/suppliers/<%= supplier.supplier_id %>/update"
                                aria-label="Edit <%= supplier.name %>"><%- include('partials/icons/pen') %></a>
                            <a href="/suppliers/<%= supplier.supplier_id %>/delete"
                                aria-label="Delete <%= supplier.name %>"><%- include('partials/icons/trash') %></a>
                        </div>
                    </li>
                    <% }) %>
            </ul>
            <% } %>

                <%- include('partials/footer') %>